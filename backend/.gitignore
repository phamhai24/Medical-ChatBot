# ─── Data ──────────────────────────────────────────────────────────────────
# The processed corpus is large and produced by data/CrawlData.ipynb.
data/processed/*
!data/processed/.gitkeep

# Generated vector DB / Chroma artifacts (rebuilt by ingest)
data/vectorstore*/
data/*.ingest.lock
data/**/*.sqlite
data/**/*.sqlite3
data/**/*.sqlite3-*
data/**/*.db
data/**/*.index
data/**/*.faiss
data/**/*.pickle
data/**/*.pkl
data/**/*.npy
data/**/*.npz
data/**/*.parquet
data/**/*.arrow

# Whole-corpus BM25 index (rebuilt by scripts/build_bm25_index.py after each ingest)
data/bm25_index/

# ─── Evaluation outputs ────────────────────────────────────────────────────
# Generated per run (timestamped HTML/CSV/raw JSON). Only the written-up
# analysis reports (*.md) are kept in git.
reports/*
!reports/*.md

# ─── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Environment ───────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Models ────────────────────────────────────────────────────────────────
models/
*.bin
*.safetensors
*.pt
*.pth

# ─── Test / tooling ────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.nox/

# ─── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
