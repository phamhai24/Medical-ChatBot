# ─── API Keys ──────────────────────────────────────────────────────────────────
# Lấy Groq key: https://console.groq.com/keys (miễn phí, nhanh)
GROQ_API_KEY=your_groq_key_here

# Lấy OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Lấy HuggingFace token: https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=your_hf_token_here

# ─── API Server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_CORS_ORIGINS=["http://localhost:5173"]
API_WARMUP_ENABLED=true
API_WARMUP_QUERY=kiểm tra sức khỏe hệ thống
ADMIN_API_KEY=

# ─── Redis (optional) ───────────────────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── Embedding Model ────────────────────────────────────────────────────────────
# bge-m3: retrieval-optimized multilingual model (covers Vietnamese), stronger
# than a general similarity model for RAG. If you ever change this on a repo
# that already has an ingested vectorstore, you MUST re-ingest — mixing
# embedding dimensions between the stored vectors and new queries errors.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_LENGTH=512

# ─── Vector Store ───────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=data/vectorstore
VECTOR_STORE_COLLECTION=medical_qa
VECTOR_SEARCH_TYPE=hybrid
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3
RETRIEVAL_FETCH_K=40
RETRIEVAL_VECTOR_WEIGHT=0.6
RETRIEVAL_BM25_WEIGHT=0.4
# Cross-encoder reranker (final precision pass over candidates) — pairs with
# bge-m3, same team, multilingual. Needs its own ~2.2GB HuggingFace download
# on first use; disable if that download can't complete on your connection.
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ─── Generation Mode ─────────────────────────────────────────────────────────────
# Chọn: "api" (dùng Groq/OpenAI, không cần GPU) hoặc "local" (dùng Qwen, cần GPU)
GENERATOR_MODE=api
GENERATOR_API_PROVIDER=groq
GENERATOR_API_MODEL=llama-3.3-70b-versatile
API_GENERATOR_MAX_RETRIES=2
API_GENERATOR_RETRY_BACKOFF=1.0
API_GENERATOR_RETRY_MAX_BACKOFF=8.0
API_GENERATOR_CIRCUIT_BREAKER_THRESHOLD=3
API_GENERATOR_CIRCUIT_BREAKER_COOLDOWN=30.0

# Cấu hình cho local (bỏ qua nếu dùng api)
GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
GENERATOR_MAX_TOKENS=512
GENERATOR_TEMPERATURE=0.3
GENERATOR_TOP_P=0.9
GENERATOR_TOP_K=50

# ─── RAGAS Evaluation ──────────────────────────────────────────────────────────
RAGAS_ENABLED=false
RAGAS_LLM_API_KEY=your_openai_key_here
RAGAS_EMBEDDING_API_KEY=your_openai_key_here

# ─── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE=logs/app.log

# ─── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
CHUNK_MIN_LENGTH=50

# ─── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
